{
  // Lynch AI inside the Auto Refresh extension.
  // Deploys to https://autorefresh-ai.lynchdigitancestudios.workers.dev/chat
  //
  // Deliberately separate from the studio-site assistant: this worker only
  // contains Auto Refresh knowledge, so the extension can never mention any
  // other product or marketplace.
  "name": "autorefresh-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Cloudflare Workers AI on your own account: no API key, no per-token bill.
  "ai": { "binding": "AI" },

  // Per-user throttle so nobody can loop the chat and burn the daily allowance.
  // Its own namespace, so extension traffic never throttles the website bot.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
